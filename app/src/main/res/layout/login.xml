<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8400A8"
    android:orientation="vertical"
    tools:context=".loginCode">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="150dp"
        android:text="Scouting"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="30dp"
        android:gravity="center"
        android:layout_marginTop="25dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="how would you like to login"
        android:textStyle="italic"
        android:layout_marginTop="50dp"
        android:textColor="@color/white"
        android:textSize="25dp" />

    <Button
        android:id="@+id/btnTester"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:text="login as a tester"
        android:backgroundTint="#FFFFFF"
        android:textColor="#000000"
        android:textSize="20dp"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnScout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:text="login as a scouter"
        android:backgroundTint="#FFFFFF"
        android:textSize="20dp"
        android:layout_marginTop="-49dp"
        android:textColor="#000000" />



</LinearLayout>